<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Perf Notes | Free Academic Resources</title>

    <meta
        name="description"
        content="Perf Notes provides free academic notes, study resources, and tutoring materials for students."
    >

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- =========================
         NAVIGATION
    ========================== -->

    <header class="navbar">
        <div class="nav-container">

            <a href="#home" class="logo">
                Perf<span>Notes</span>
            </a>

            <button
                class="menu-toggle"
                id="menuToggle"
                aria-label="Open navigation menu"
            >
                ☰
            </button>

            <nav id="navMenu">
                <a href="#home">Home</a>
                <a href="#about">About</a>
                <a href="#subjects">Subjects</a>
                <a href="#resources">Resources</a>
                <a href="#impact">Impact</a>
                <a href="#contact">Contact</a>
            </nav>

        </div>
    </header>


    <!-- =========================
         HERO
    ========================== -->

    <main>

        <section id="home" class="hero">

            <div class="hero-content">

                <p class="eyebrow">
                    FREE ACADEMIC RESOURCES
                </p>

                <h1>
                    Learn better.<br>
                    <span>Study smarter.</span>
                </h1>

                <p class="hero-text">
                    Perf Notes is a free collection of student-created
                    notes, study materials, and academic resources designed
                    to make learning more accessible.
                </p>

                <div class="hero-buttons">

                    <a href="#resources" class="button primary-button">
                        Explore Resources
                    </a>

                    <a href="#about" class="button secondary-button">
                        Learn More
                    </a>

                </div>

            </div>

            <div class="hero-card">

                <div class="card-top">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </div>

                <div class="notes-preview">

                    <p class="preview-label">
                        CURRENTLY STUDYING
                    </p>

                    <h3>
                        Your next study session
                    </h3>

                    <div class="preview-line"></div>

                    <div class="preview-item">
                        <span>01</span>
                        Review class notes
                    </div>

                    <div class="preview-item">
                        <span>02</span>
                        Practice key concepts
                    </div>

                    <div class="preview-item">
                        <span>03</span>
                        Prepare for assessments
                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             STATS
        ========================== -->

        <section class="stats">

            <div class="stat">
                <strong>700+</strong>
                <span>Students Reached</span>
            </div>

            <div class="stat">
                <strong>100%</strong>
                <span>Free Resources</span>
            </div>

            <div class="stat">
                <strong>8+</strong>
                <span>Years of Notes</span>
            </div>

            <div class="stat">
                <strong>∞</strong>
                <span>Learning Opportunities</span>
            </div>

        </section>


        <!-- =========================
             ABOUT
        ========================== -->

        <section id="about" class="section about">

            <div class="section-heading">

                <p class="eyebrow">
                    ABOUT PERF NOTES
                </p>

                <h2>
                    Notes made to help
                    <span>students learn.</span>
                </h2>

            </div>

            <div class="about-grid">

                <div class="about-text">

                    <p>
                        Perf Notes began with a simple idea:
                        students should be able to access useful
                        academic resources without having to pay for them.
                    </p>

                    <p>
                        Over the years, I have collected and organized
                        notes from my classes into resources that other
                        students can use to review concepts, fill gaps in
                        their understanding, and prepare for assessments.
                    </p>

                    <p>
                        Perf Notes is not intended to replace your teachers
                        or your classroom experience. Instead, it is meant
                        to be another tool in your academic toolbox.
                    </p>

                </div>

                <div class="about-box">

                    <div class="about-number">
                        01
                    </div>

                    <h3>
                        Learn
                    </h3>

                    <p>
                        Build a stronger understanding of concepts
                        through organized explanations and notes.
                    </p>

                </div>

                <div class="about-box">

                    <div class="about-number">
                        02
                    </div>

                    <h3>
                        Review
                    </h3>

                    <p>
                        Return to resources whenever you need
                        a refresher on material from class.
                    </p>

                </div>

                <div class="about-box">

                    <div class="about-number">
                        03
                    </div>

                    <h3>
                        Grow
                    </h3>

                    <p>
                        Develop study habits and strategies that
                        can support you throughout high school.
                    </p>

                </div>

            </div>

        </section>


        <!-- =========================
             SUBJECTS
        ========================== -->

        <section id="subjects" class="section subjects">

            <div class="section-heading centered">

                <p class="eyebrow">
                    EXPLORE
                </p>

                <h2>
                    Find your <span>subject.</span>
                </h2>

                <p>
                    Browse resources by academic area.
                </p>

            </div>


            <div class="subject-grid">

                <article class="subject-card">
                    <div class="subject-number">01</div>
                    <h3>Mathematics</h3>
                    <p>
                        Notes, formulas, examples, and review
                        materials for math courses.
                    </p>
                    <a href="#resources">View Resources →</a>
                </article>


                <article class="subject-card">
                    <div class="subject-number">02</div>
                    <h3>Science</h3>
                    <p>
                        Organized notes and study materials
                        for science courses.
                    </p>
                    <a href="#resources">View Resources →</a>
                </article>


                <article class="subject-card">
                    <div class="subject-number">03</div>
                    <h3>History</h3>
                    <p>
                        Key events, concepts, people, and
                        historical analysis.
                    </p>
                    <a href="#resources">View Resources →</a>
                </article>


                <article class="subject-card">
                    <div class="subject-number">04</div>
                    <h3>English</h3>
                    <p>
                        Reading, writing, analysis, and
                        study resources.
                    </p>
                    <a href="#resources">View Resources →</a>
                </article>


                <article class="subject-card">
                    <div class="subject-number">05</div>
                    <h3>Languages</h3>
                    <p>
                        Vocabulary, grammar, and language
                        learning resources.
                    </p>
                    <a href="#resources">View Resources →</a>
                </article>


                <article class="subject-card">
                    <div class="subject-number">06</div>
                    <h3>AP Courses</h3>
                    <p>
                        Review materials and notes for
                        advanced coursework.
                    </p>
                    <a href="#resources">View Resources →</a>
                </article>

            </div>

        </section>


        <!-- =========================
             RESOURCES
        ========================== -->

        <section id="resources" class="section resources">

            <div class="section-heading">

                <p class="eyebrow">
                    RESOURCES
                </p>

                <h2>
                    Start <span>studying.</span>
                </h2>

                <p>
                    Choose a resource below to begin.
                </p>

            </div>


            <div class="resource-grid">

                <article class="resource-card">

                    <div class="resource-icon">
                        📚
                    </div>

                    <h3>
                        Class Notes
                    </h3>

                    <p>
                        Detailed notes organized by course and
                        topic.
                    </p>

                    <button
                        class="resource-button"
                        onclick="showResourceMessage('Class Notes')"
                    >
                        Explore →
                    </button>

                </article>


                <article class="resource-card">

                    <div class="resource-icon">
                        ✏️
                    </div>

                    <h3>
                        Study Guides
                    </h3>

                    <p>
                        Condensed materials to help you review
                        important concepts.
                    </p>

                    <button
                        class="resource-button"
                        onclick="showResourceMessage('Study Guides')"
                    >
                        Explore →
                    </button>

                </article>


                <article class="resource-card">

                    <div class="resource-icon">
                        📝
                    </div>

                    <h3>
                        Practice Materials
                    </h3>

                    <p>
                        Use practice questions and examples to
                        test your understanding.
                    </p>

                    <button
                        class="resource-button"
                        onclick="showResourceMessage('Practice Materials')"
                    >
                        Explore →
                    </button>

                </article>

            </div>

            <div id="resourceMessage" class="resource-message"></div>

        </section>


        <!-- =========================
             IMPACT
        ========================== -->

        <section id="impact" class="impact-section">

            <div class="impact-content">

                <p class="eyebrow">
                    OUR IMPACT
                </p>

                <h2>
                    Education should be
                    <span>accessible.</span>
                </h2>

                <p>
                    What started as personal notes has grown into
                    a resource used by students both within my
                    school community and through academic programs
                    beyond it.
                </p>

                <div class="impact-stat">
                    <strong>700+</strong>
                    <span>students reached through Perf Notes</span>
                </div>

            </div>

        </section>


        <!-- =========================
             CONTACT
        ========================== -->

        <section id="contact" class="section contact">

            <div class="contact-container">

                <div>

                    <p class="eyebrow">
                        GET IN TOUCH
                    </p>

                    <h2>
                        Have a question?
                    </h2>

                    <p>
                        Have a suggestion, found an issue, or want
                        to contribute a resource? Get in touch.
                    </p>

                </div>


                <form
                    class="contact-form"
                    id="contactForm"
                >

                    <label for="name">
                        Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Your name"
                        required
                    >


                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Your email"
                        required
                    >


                    <label for="message">
                        Message
                    </label>

                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        placeholder="Your message"
                        required
                    ></textarea>


                    <button
                        type="submit"
                        class="button primary-button"
                    >
                        Send Message
                    </button>

                    <p id="formMessage"></p>

                </form>

            </div>

        </section>

    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

        <div class="footer-container">

            <div>

                <a href="#home" class="logo">
                    Perf<span>Notes</span>
                </a>

                <p>
                    Free resources for better learning.
                </p>

            </div>


            <div class="footer-links">

                <a href="#about">About</a>
                <a href="#subjects">Subjects</a>
                <a href="#resources">Resources</a>
                <a href="#contact">Contact</a>

            </div>

        </div>


        <div class="footer-bottom">

            <p>
                © <span id="year"></span> Perf Notes. All rights reserved.
            </p>

            <p>
                Created to make learning more accessible.
            </p>

        </div>

    </footer>


    <script src="js/script.js"></script>

</body>
</html>
